generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id              String   @id @default(cuid())
  roleId          String
  email           String   @unique
  username        String   @unique
  passwordHash    String
  fullName        String
  phone           String?
  status          String   @default("ACTIVE")
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  role                         Role                       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  auditLogs                    AuditLog[]
  createdDevices               Device[]                   @relation("DeviceCreatedBy")
  updatedDevices               Device[]                   @relation("DeviceUpdatedBy")
  deliveredAssignments         DeviceAssignment[]         @relation("AssignmentDeliveredBy")
  maintenanceUsers             DeviceMaintenance[]        @relation("MaintenanceUser")
  createdMaintenances          DeviceMaintenance[]        @relation("MaintenanceCreatedBy")
  createdConsumableMovements   ConsumableMovement[]       @relation("ConsumableMovementCreatedBy")

  @@index([roleId])
  @@map("users")
}


model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  module      String
  entityName  String
  entityId    String
  action      String
  oldValues   String?  @db.LongText
  newValues   String?  @db.LongText
  ipAddress   String?
  createdAt   DateTime @default(now())

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([actorUserId])
  @@index([module])
  @@index([entityName, entityId])
  @@map("audit_logs")
}

model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouses Warehouse[]

  @@map("branches")
}

model Warehouse {
  id                  String               @id @default(cuid())
  branchId            String
  name                String
  code                String               @unique
  description         String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  branch              Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  devices             Device[]
  assignments         DeviceAssignment[]
  maintenances        DeviceMaintenance[]
  consumableMovements ConsumableMovement[]
  tickets             Ticket[]

  @@index([branchId])
  @@unique([branchId, name])
  @@map("warehouses")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices             Device[]
  assignments         DeviceAssignment[]
  maintenances        DeviceMaintenance[]
  consumableMovements ConsumableMovement[]

  @@map("departments")
}

model DeviceType {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices Device[]

  @@map("device_types")
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices Device[]

  @@map("brands")
}

model Device {
  id                     String      @id @default(cuid())
  deviceCode             String      @unique
  deviceTypeId           String
  brandId                String
  warehouseId            String
  currentResponsibleName String?
  departmentId           String?
  serialNumber           String      @unique
  model                  String?
  partNumber             String?
  description            String?
  invoiceNumber          String?
  cost                   Decimal?    @db.Decimal(12, 2)
  purchaseDate           DateTime?
  wifiMac                String?
  bluetoothMac           String?
  qrCode                 String?
  barcode                String?
  status                 String      @default("AVAILABLE")
  phoneNumber            String?
  imei                   String?
  iccid                  String?
  simNumber              String?
  gmailAccount           String?
  gmailPasswordEncrypted String?
  localPasswordEncrypted String?
  teamviewerId           String?
  computerName           String?
  notes                  String?     @db.Text
  createdByUserId        String
  updatedByUserId        String
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  deletedAt              DateTime?

  deviceType   DeviceType          @relation(fields: [deviceTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  brand        Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  department   Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy    User                @relation("DeviceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updatedBy    User                @relation("DeviceUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignments  DeviceAssignment[]
  maintenances DeviceMaintenance[]

  @@index([deviceTypeId])
  @@index([brandId])
  @@index([warehouseId])
  @@index([departmentId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@map("devices")
}

model DeviceAssignment {
  id                   String    @id @default(cuid())
  deviceId             String
  assignedToName       String
  assignedByUserId     String
  warehouseId          String
  departmentId         String?
  assignedAt           DateTime
  returnedAt           DateTime?
  status               String    @default("ACTIVE")
  deliveryNotes        String?   @db.Text
  devicePhotoPath      String?
  deliveryDocumentPath String?
  policyDocumentPath   String?
  signaturePath        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  device       Device      @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedBy   User        @relation("AssignmentDeliveredBy", fields: [assignedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouse    Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([deviceId])
  @@index([assignedToName])
  @@index([assignedByUserId])
  @@index([warehouseId])
  @@index([departmentId])
  @@index([status])
  @@map("device_assignments")
}

model DeviceMaintenance {
  id                   String    @id @default(cuid())
  deviceId             String
  warehouseId          String
  userId               String?
  departmentId         String?
  maintenanceDate      DateTime
  maintenanceType      String
  deviceSnapshotType   String?
  deviceSnapshotBrand  String?
  deviceSnapshotSerial String?
  failureDescription   String?   @db.Text
  solutionDescription  String?   @db.Text
  notes                String?   @db.Text
  fixedBy              String?
  createdByUserId      String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  device      Device      @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user        User?       @relation("MaintenanceUser", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy   User        @relation("MaintenanceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([deviceId])
  @@index([warehouseId])
  @@index([userId])
  @@index([departmentId])
  @@index([createdByUserId])
  @@index([maintenanceType])
  @@map("device_maintenance")
}

model ConsumableItem {
  id            String                   @id @default(cuid())
  code          String                   @unique
  name          String                   @unique
  info          String?                  @db.Text
  photoPath     String?
  unit          String
  initialStock  Decimal                  @default(0) @db.Decimal(12, 2)
  currentStock  Decimal                  @default(0) @db.Decimal(12, 2)
  minimumStock  Decimal                  @default(0) @db.Decimal(12, 2)
  maximumStock  Decimal?                 @db.Decimal(12, 2)
  isActive      Boolean                  @default(true)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  movementItems ConsumableMovementItem[]

  @@map("consumable_items")
}

model ConsumableMovement {
  id              String                   @id @default(cuid())
  folio           String                   @unique
  movementType    String
  warehouseId     String?
  departmentId    String?
  employeeName    String?
  deliveredByName String?
  movementDate    DateTime
  signaturePath   String?
  documentPath    String?
  notes           String?                  @db.Text
  createdByUserId String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  warehouse       Warehouse?               @relation(fields: [warehouseId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  department      Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy       User                     @relation("ConsumableMovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items           ConsumableMovementItem[]

  @@index([warehouseId])
  @@index([departmentId])
  @@index([createdByUserId])
  @@index([movementType])
  @@index([movementDate])
  @@map("consumable_movements")
}


model ConsumableMovementItem {
  id               String             @id @default(cuid())
  movementId       String
  consumableItemId String
  quantity         Decimal            @db.Decimal(12, 2)
  unit             String
  itemNameSnapshot String
  itemCodeSnapshot String?
  notes            String?            @db.Text
  createdAt        DateTime           @default(now())

  movement         ConsumableMovement @relation(fields: [movementId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  consumableItem   ConsumableItem     @relation(fields: [consumableItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([movementId])
  @@index([consumableItemId])
  @@map("consumable_movement_items")
}


model Ticket {
  id                   String    @id @default(cuid())
  idTicket             String    @unique
  qtyOfMovementsNeeded Int?
  externalId           String?
  description          String?   @db.Text
  status               String
  priority             String?
  category             String?
  affectedDocumentId   String?
  requestBy            String?
  latestAgent          String?
  assignedAgent        String?
  supportFilePath      String?
  authorized           Boolean?
  warehouseId          String?
  createdAtSource      DateTime?
  solvedAt             DateTime?
  type                 String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status])
  @@index([category])
  @@index([warehouseId])
  @@index([createdAtSource])
  @@index([solvedAt])
  @@map("tickets")
}

model AppSequence {
  id           String   @id @default(cuid())
  code         String   @unique
  prefix       String
  currentValue Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("app_sequences")
}

